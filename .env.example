DATABASE_URL=sqlite:///./clinic.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=clinic-api
JWT_AUDIENCE=clinic-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
M2M_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Used only to create the first partner client when it does not yet exist.
OAUTH_BOOTSTRAP_CLIENT_ID=partner-example
OAUTH_BOOTSTRAP_CLIENT_SECRET=replace-with-a-secret-stored-outside-git
OAUTH_BOOTSTRAP_CLIENT_SCOPES=partner:consultas:read
